{
  "name": "lookupsafe-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:local": "wrangler d1 migrations apply lookupsafe --local",
    "db:remote": "wrangler d1 migrations apply lookupsafe --remote"
  },
  "dependencies": {
    "hono": "^4.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "typescript": "^5.7.0",
    "vitest": "^5.1.1",
    "wrangler": "^4.45.0"
  },
  "engines": {
    "node": ">=24"
  }
}
